# 本地环境配置（以后存数据库密码等敏感信息），绝不上传
.env

# 云函数部署配置：里面有数据库密码，所以只留一份示例在仓库里（cloudbaserc.example.json）
cloudbaserc.json

# 一次性数据库诊断函数（里面有密码，测完就删，永不上传）
cloudfunctions/pgtest/

# 依赖目录（以后装了 Node 依赖会生成）
node_modules/

# WorkBuddy 的工作数据，不属于网站文件（Day 12 起放行 skills/：Skill 说明书要跟着仓库走）
.workbuddy/*
!.workbuddy/skills/

# WorkBuddy 应用发布的本地产物
.wbapp_*

# 系统垃圾文件
.DS_Store
Thumbs.db
